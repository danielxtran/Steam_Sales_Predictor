# Steam Web API key — optional but enables filtered app list pagination
# Get one at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# IsThereAnyDeal API key — required for price history data
# Get one at: https://isthereanydeal.com/dev/app/
ITAD_API_KEY=

# Database connection string (SQLAlchemy URL).
# Leave blank to use the local SQLite file at data/steam_prices.db
# (equivalent to sqlite:///data/steam_prices.db, resolved from the project root).
# In production this is the Neon Postgres URL.
DATABASE_URL=
